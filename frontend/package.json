{
  "name": "judicabot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "gen:openapi": "uv run --project ../backend python -m tutela2.openapi_export",
    "gen:tipos": "pnpm gen:openapi && openapi-typescript openapi.json -o src/api/schema.d.ts",
    "check:tipos": "openapi-typescript openapi.json -o src/api/schema.d.ts --check",
    "e2e": "playwright test --pass-with-no-tests"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^24.19.2",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
