{
  "manifest_version": 3,
  "name": "Judicabot: consultas públicas",
  "version": "1.1.0",
  "description": "Hace para judicabot, desde este navegador, dos consultas públicas: la relatoría de la Corte y la vigencia de tarjetas de abogado.",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "storage"],
  "host_permissions": [
    "https://www.corteconstitucional.gov.co/relatoria/*",
    "https://vigenciaspublicas.ramajudicial.gov.co/Certificados.aspx"
  ],
  "background": {
    "service_worker": "trabajador.js",
    "type": "module"
  },
  "action": {
    "default_popup": "ventana.html",
    "default_title": "Judicabot: consultas públicas",
    "default_icon": {
      "16": "iconos/16.png",
      "32": "iconos/32.png",
      "48": "iconos/48.png",
      "128": "iconos/128.png"
    }
  },
  "icons": {
    "16": "iconos/16.png",
    "32": "iconos/32.png",
    "48": "iconos/48.png",
    "128": "iconos/128.png"
  }
}
